<Project Sdk="Microsoft.NET.Sdk">

  <!-- Synthetic live-test target (not part of the product or the solution): an "idle app" with a hot set,
       a periodic GC-like sweep and cold memory, plus one scheduled activity burst. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RpDummy</AssemblyName>
    <RootNamespace>RpDummy</RootNamespace>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

</Project>
