<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure policy library: no P/Invoke, no I/O, no clocks. Everything the engine decides is decided here
       and is unit-tested in tests/RamPilot.Core.Tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RamPilot.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
